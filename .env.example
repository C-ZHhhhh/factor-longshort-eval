# Alpaca API密钥(用于备用数据源)
# 注册地址: https://alpaca.markets
# 免费账户即可获取市场数据API访问权限
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# 可选: 使用paper trading URL或live URL
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # 模拟交易(默认)
# ALPACA_BASE_URL=https://api.alpaca.markets        # 真实账户
