# =============================================================================
# Results Directory - Whitelist Strategy
# =============================================================================
# Default: Ignore everything in results/
results/**

# Whitelist: Core deliverable files
!results/EVALUATION_REPORT.md
!results/performance_table.csv
!results/performance_table.md
!results/robustness_table.csv
!results/robustness_table.md
!results/exposure_summary.md
!results/significance_summary.md
!results/cagr_diagnostics.md

# Whitelist: Core figures directory and README
!results/figures/
!results/figures/README.md

# Whitelist: Only fig_01 to fig_06 (交付版图表)
!results/figures/fig_01_*.png
!results/figures/fig_02_*.png
!results/figures/fig_03_*.png
!results/figures/fig_04_*.png
!results/figures/fig_05_*.png
!results/figures/fig_06_*.png

# Explicitly ignore archive and all other files in figures/
results/figures/archive/
